# Database
DATABASE_URL="your-database-url-here"

# JWT
JWT_SECRET="your-jwt-secret-here"

# Server
PORT=3002
NODE_ENV=development

# Frontend URL (replace with your Render frontend URL)
FRONTEND_URL=http://localhost:3000

# --- SMTP Configuration (choose one option below) ---

# Option A: Resend (recommended)
# 1. Go to https://resend.com and create an account
# 2. Create an API key
# 3. Add a verified domain or use their default
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key-here
SMTP_FROM=onboarding@resend.dev
SMTP_FROM_NAME=TaskPilot

# Option B: Gmail SMTP
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account > Security > 2FA > App Passwords
# 3. Generate an app password for "Mail"
# 4. Use the app password below (NOT your regular Gmail password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=asinguradesirecomfort@gmail.com
# SMTP_PASS=your-16-character-app-password-here
# SMTP_FROM=asinguradesirecomfort@gmail.com
# SMTP_FROM_NAME=TaskPilot
